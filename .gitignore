# ======================================================================
# .gitignore - vrc2gtav Project
# ======================================================================

# Staging directories and temporary GTA V RPF extraction dumps
staging/
*_extracted/
*.rpf
*.bak
*.tmp
*~

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/

# Operating system metadata and IDE files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Blender backup files
*.blend1
*.blend2

# RAGE and Blender rendered images
renders/

# Compiled GTA V game files and proprietary assets (excluded for copyright safety)
*.yft
*.yft.xml
*.ydd
*.ydd.xml
*.ytd
*.dds
*.backup_*

# Technical exception: empty dummy mesh containers (no copyrighted geometry/textures)
!_deploy_tools/head_000_r.ydd
!_deploy_tools/p_eyes_dummy.ydd
!unity_plugin/Assets/VRCAvatar2GTAV/Toolchain/_deploy_tools/head_000_r.ydd
!unity_plugin/Assets/VRCAvatar2GTAV/Toolchain/_deploy_tools/p_eyes_dummy.ydd

# Machine-local path configuration and dynamic registries
vrc2gtav.cfg
configs/npc_registry.json

# Local backups, downloads, logs, tools, and runtime-generated outputs
backups/
logs/
tools/
imported_unity_projects/
npcs/
*.zip
*.unitypackage
dist/
player_one/3_textures_gtav/textures/
player_one/4_exported_models/
player_one/5_rpf_package/
player_zero/3_textures_gtav/textures_atlas/
player_zero/4_exported_models/
player_zero/5_rpf_package/vtoon_profiles/
player_zero/5_rpf_package/mppatches_work/
vtoon_profiles/
vtoon_lut_*.png
vtoon_matcap_*.png
player_two/3_textures_gtav/*.png
player_two/3_textures_gtav/custom_hair_manifest.json
player_two/4_exported_models/
player_two/5_rpf_package/

# ======================================================================
# .gitignore - vrc2gtav Project
# ======================================================================

# Staging directories and temporary GTA V RPF extraction dumps
staging/
*_extracted/
*.rpf
*.bak
*.tmp
*~

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/

# Operating system metadata and IDE files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Blender backup files
*.blend1
*.blend2

# RAGE and Blender rendered images
renders/

# Compiled GTA V game files and proprietary assets (excluded for copyright safety)
*.yft
*.yft.xml
*.ydd
*.ydd.xml
*.ytd
*.dds
*.backup_*

# Technical exception: empty dummy mesh containers (no copyrighted geometry/textures)
!_deploy_tools/head_000_r.ydd
!_deploy_tools/p_eyes_dummy.ydd

# Machine-local path configuration (generated from vrc2gtav.cfg.example)
vrc2gtav.cfg

# Local backups, downloads, logs, tools, and runtime-generated outputs
backups/
logs/
tools/
imported_unity_projects/
*.zip
*.unitypackage
1_Franklin_Shinano_Casual/3_textures_gtav/textures/
1_Franklin_Shinano_Casual/4_exported_models/
2_Michael_Shinano_EternalReunion/3_textures_gtav/textures_atlas/
2_Michael_Shinano_EternalReunion/4_exported_models/
3_Trevor_Miltina_Maid/3_textures_gtav/*.png
3_Trevor_Miltina_Maid/4_exported_models/

# ==============================================================================
# vrc2gtav.cfg.example
# Centralized path and language configuration template for the vrc2gtav project.
#
# On first run (or by running `python run_mod_manager.py --setup`), the local
# `vrc2gtav.cfg` file (ignored by Git) is generated automatically from this
# template and populated with the real paths on your machine.
#
# Editing rules:
#   - You may use forward slashes (C:/...) on both Windows and Linux/WSL.
#   - The resolver (vrc2gtav_paths.py) automatically translates between Windows
#     paths (X:/...) and WSL paths (/mnt/x/...) based on the host OS.
#   - Variables written as ${section:key} are interpolated automatically.
#   - Set VRC2GTAV_CFG in the environment to point to a custom .cfg file.
#   - Set [general] language = auto | en | ja | pt (or VRC2GTAV_LANG env var).
# ==============================================================================

[general]
# Interface language: auto (detect from OS locale), en (English), ja (Japanese), pt (Portuguese)
language = auto

[directories]
# '.' resolves automatically to the directory containing vrc2gtav.cfg.
project_root = .
unity_assets = C:/VRChatProjects/waifuv4/Assets
gtav_root = C:/Games/Grand Theft Auto V
gtav_mods = ${gtav_root}/mods
staging = ${project_root}/staging
deploy_tools = ${project_root}/_deploy_tools
scripts_root = ${project_root}/scripts
common_tools = ${scripts_root}/common_tools
backups = ${project_root}/backups
renders_output = ${staging}/output
artifacts =

[executables]
blender = C:/Program Files/Blender Foundation/Blender 4.0/blender.exe
rage = rage
python = python3
ffmpeg = ffmpeg
windows_cmd = C:/Windows/System32/cmd.exe

[common_assets]
dummy_ydd = ${directories:deploy_tools}/head_000_r.ydd
prop_dummy_ydd = ${directories:deploy_tools}/p_eyes_dummy.ydd
manager_script = ${directories:project_root}/run_mod_manager.py
apply_characters_script = ${directories:common_tools}/apply_characters.py
apply_all_characters_script = ${directories:common_tools}/apply_all_characters.py
repack_deploy_script = ${directories:common_tools}/repack_and_deploy_everything.py
test_suite_script = ${directories:common_tools}/test_mod_suite.py

[rpf_paths]
streamedpeds_extracted = ${directories:staging}/streamedpeds_players_extracted
streamedpeds_rpf_relative = models/cdimages/streamedpeds_players.rpf
x64v_extracted = ${directories:staging}/x64v_extracted
x64v_modded_rpf = ${directories:staging}/x64v_modded.rpf
x64v_game_rpf = ${directories:gtav_mods}/x64v.rpf
x64v_vanilla_rpf = ${directories:gtav_root}/x64v.rpf

mppatches_extracted = ${directories:staging}/mppatches_extracted
mppatches_dlc_extracted = ${directories:staging}/mppatchesng_extracted
mppatches_modded_rpf = ${directories:staging}/mppatchesng_dlc.rpf
mppatches_game_rpf = ${directories:gtav_mods}/update/x64/dlcpacks/mppatchesng/dlc.rpf
mppatches_rpf_relative = x64/models/cdimages/mppatches.rpf

patchday3ng_models_extracted = ${directories:staging}/patchday3ng_models_extracted
patchday3ng_dlc_extracted = ${directories:staging}/patchday3ng_dlc_extracted
patchday3ng_modded_rpf = ${directories:staging}/patchday3ng_dlc.rpf
patchday3ng_game_rpf = ${directories:gtav_mods}/update/x64/dlcpacks/patchday3ng/dlc.rpf
patchday3ng_rpf_relative = x64/models/cdimages/patchday3ng.rpf

patchday4ng_models_extracted = ${directories:staging}/patchday4ng_models_extracted
patchday4ng_dlc_extracted = ${directories:staging}/patchday4ng_dlc_extracted
patchday4ng_modded_rpf = ${directories:staging}/patchday4ng_dlc.rpf
patchday4ng_game_rpf = ${directories:gtav_mods}/update/x64/dlcpacks/patchday4ng/dlc.rpf
patchday4ng_rpf_relative = x64/models/cdimages/patchday4ng.rpf

vanilla_skeletons_backup = ${directories:staging}/backup_vanilla_skeletons
streamedpeds_backup_player_two = ${directories:staging}/backup_vanilla_player_two/player_two
mppatches_backup_player_two = ${directories:staging}/backup_vanilla_mppatches_player_two/player_two
streamedpedprops_extracted = ${directories:staging}/streamedpedprops_extracted
streamedpedprops_rpf_relative = models/cdimages/streamedpedprops.rpf
streamedpedprops_backup_p_eyes = ${directories:staging}/backup_vanilla_streamedpedprops_p_eyes

# ==============================================================================
# GTA V Protagonist Slots (Interchangeable VRChat Avatar Assignments)
# Change `avatar` on any protagonist to swap characters freely:
#   Options: shinano_casual | shinano_er | miltina_maid
# Optional per-protagonist hair override:
#   custom_hair = auto | default | none | <path to .prefab or .fbx>
#   hair_mat    = <optional .mat override>
#   hair_tex    = <optional texture override>
#   hair_scale  = 1.0
#   hair_offset = 0,0,0
# ==============================================================================

[franklin]
avatar = shinano_casual
ped_name = player_one
prop_ped_name = player_one_p
skeleton_yft = ${avatar_shinano_casual:character_dir}/2_blender/player_one.yft
physbones_cfg = ${directories:project_root}/configs/shinano_casual_physbones.cfg
target_z_min = -0.907
target_z_max = 0.640
arm_pose_degrees = -55.0
staging_streamed_ped_dir = ${rpf_paths:streamedpeds_extracted}/player_one
staging_mppatches_ped_dir = ${rpf_paths:mppatches_extracted}/player_one
staging_patchday4_ped_dir = ${rpf_paths:patchday4ng_models_extracted}/player_one
staging_streamed_props_dir = ${rpf_paths:streamedpedprops_extracted}/player_one_p

[michael]
avatar = shinano_er
ped_name = player_zero
prop_ped_name = player_zero_p
skeleton_yft = ${avatar_shinano_er:character_dir}/2_blender/player_zero.yft
physbones_cfg = ${directories:project_root}/configs/michael_neko_mimi_physbones.cfg
target_z_min = -0.907
target_z_max = 0.645
arm_pose_degrees = -55.0
staging_streamed_ped_dir = ${rpf_paths:streamedpeds_extracted}/player_zero
staging_mppatches_ped_dir = ${rpf_paths:mppatches_extracted}/player_zero
staging_patchday4_ped_dir = ${rpf_paths:patchday4ng_models_extracted}/player_zero
staging_streamed_props_dir = ${rpf_paths:streamedpedprops_extracted}/player_zero_p

[trevor]
avatar = miltina_maid
ped_name = player_two
prop_ped_name = player_two_p
skeleton_yft = ${avatar_miltina_maid:character_dir}/2_blender/player_two.yft
physbones_cfg = ${directories:project_root}/configs/miltina_maid_physbones.cfg
target_z_min = -0.908
target_z_max = 0.642
arm_pose_degrees = -55.0
staging_streamed_ped_dir = ${rpf_paths:streamedpeds_extracted}/player_two
staging_mppatches_ped_dir = ${rpf_paths:mppatches_extracted}/player_two
staging_patchday4_ped_dir = ${rpf_paths:patchday4ng_models_extracted}/player_two
staging_streamed_props_dir = ${rpf_paths:streamedpedprops_extracted}/player_two_p

# ==============================================================================
# VRChat Avatar Presets (Protagonist-Independent Assets, Textures & Builders)
# ==============================================================================

